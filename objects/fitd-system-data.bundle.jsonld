      "contentDigest": "sha256-25a43a32ebccee0d5708ac6c0021c2755f9701b6d3ad8eb5241bb46785f47cfd"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/a-little-something-on-the-side",
      "@type": "SpecialAbility",
      "name": "A little something on the side",
      "slug": "a-little-something-on-the-side",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.35",
        "heading": "A little something on the side",
        "lineStart": 1240,
        "lineEnd": 1244
      },
      "rulesText": "At the end of each downtime phase, you earn **+2 stash**.",
      "commentary": "Since this money comes at the end of downtime, after all downtime actions are resolved, you can't remove it from your stash and spend it on extra activities until your next downtime phase.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/accord",
      "@type": "SpecialAbility",
      "name": "Accord",
      "slug": "accord",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.17",
        "heading": "Accord",
        "lineStart": 1671,
        "lineEnd": 1675
      },
      "rulesText": "Sometimes friends are as good as territory. You may treat up to three **+3 faction statuses** you hold as if they are **turf**.",
      "commentary": "If your status changes, you lose the turf until it becomes +3 again. Regardless of how much turf you hold (from this ability or otherwise) the minimum **rep** cost to advance your Tier is always 6.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/alchemist",
      "@type": "SpecialAbility",
      "name": "Alchemist",
      "slug": "alchemist",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.20",
        "heading": "Alchemist",
        "lineStart": 1146,
        "lineEnd": 1150
      },
      "rulesText": "When you **invent** or **craft** a creation with *alchemical* features, you get **+1 result level** to your roll (a **1-3** becomes a **4/5**, etc.). You begin with one special formula already known.",
      "commentary": "Follow the Inventing procedure with the GM to define your first special alchemical formula.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/all-hands",
      "@type": "SpecialAbility",
      "name": "All hands",
      "slug": "all-hands",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.22",
        "heading": "All hands",
        "lineStart": 1697,
        "lineEnd": 1699
      },
      "rulesText": "During **downtime**, one of your **cohorts** may perform a downtime activity for the crew to **acquire an asset**, **reduce** **heat**, or work on a **long-term project**.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/ambush",
      "@type": "SpecialAbility",
      "name": "Ambush",
      "slug": "ambush",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.27",
        "heading": "Ambush",
        "lineStart": 1188,
        "lineEnd": 1192
      },
      "rulesText": "When you attack from hiding or spring a trap, you get **+1d** to your roll.",
      "commentary": "This ability benefits from preparation— so don't forget you can do that in a flashback.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/analyst",
      "@type": "SpecialAbility",
      "name": "Analyst",
      "slug": "analyst",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.21",
        "heading": "Analyst",
        "lineStart": 1152,
        "lineEnd": 1154
      },
      "rulesText": "During downtime, you get **two ticks** to distribute among any long term project clocks that involve investigation or learning a new formula or design plan.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/anointed",
      "@type": "SpecialAbility",
      "name": "Anointed",
      "slug": "anointed",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.16",
        "heading": "Anointed",
        "lineStart": 1667,
        "lineEnd": 1669
      },
      "rulesText": "You gain **+1d** to **resistance** rolls against supernatural threats. You get **+1d** to healing rolls when you have supernatural harm.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/arcane-fighter",
      "@type": "SpecialAbility",
      "name": "Arcane fighter",
      "slug": "arcane-fighter",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.9",
        "heading": "Arcane fighter",
        "lineStart": 1076,
        "lineEnd": 1080
      },
      "rulesText": "You may imbue your hands, melee weapons, or tools with spirit energy. You gain **potency** in combat vs. the supernatural..",
      "commentary": "When you imbue yourself with arcane energy, how do you do it? What does it look like when the energy manifests?",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/arcane-mind",
      "@type": "SpecialAbility",
      "name": "Arcane mind",
      "slug": "arcane-mind",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.44",
        "heading": "Arcane mind",
        "lineStart": 1294,
        "lineEnd": 1296
      },
      "rulesText": "You're always aware of supernatural entities in your presence. Take **+1d** whenever you **gather information** about the supernatural by any means.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/artificer",
      "@type": "SpecialAbility",
      "name": "Artificer",
      "slug": "artificer",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.22",
        "heading": "Artificer",
        "lineStart": 1156,
        "lineEnd": 1160
      },
      "rulesText": "When you **invent** or **craft** a creation with *spark-craft* features, you get **+1 result level** to your roll (a **1-3** becomes a **4/5**, etc.). You begin with one special design already known.",
      "commentary": "Follow the Inventing procedure with the GM to define your first spark-craft design.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/battleborn",
      "@type": "SpecialAbility",
      "name": "Battleborn",
      "slug": "battleborn",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.7",
        "heading": "Battleborn",
        "lineStart": 1064,
        "lineEnd": 1068
      },
      "rulesText": "You may expend your **special armor** to reduce harm from an attack in combat or to **push yourself** during a fight.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you \"reduce harm\" that means the level of harm you're facing right now is reduced by one. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/bodyguard",
      "@type": "SpecialAbility",
      "name": "Bodyguard",
      "slug": "bodyguard",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.8",
        "heading": "Bodyguard",
        "lineStart": 1070,
        "lineEnd": 1074
      },
      "rulesText": "When you **protect** a teammate, take **+1d** to your resistance roll. When you gather info to anticipate possible threats in the current situation, you get **+1 effect**.",
      "commentary": "The protect teamwork maneuver lets you face a consequence for a teammate. If you choose to resist that consequence, this ability gives you +1d to your resistance roll. Also, when you read a situation to gather information about hidden dangers or potential attackers, you get +1 effect—which means more detailed information.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/calculating",
      "@type": "SpecialAbility",
      "name": "Calculating",
      "slug": "calculating",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.40",
        "heading": "Calculating",
        "lineStart": 1270,
        "lineEnd": 1274
      },
      "rulesText": "Due to your careful planning, during downtime, you may give yourself or another crew member **+1 downtime activity**.",
      "commentary": "If you forget to use this ability during downtime, you can still activate it during the score and flashback to the previous downtime when the extra activity happened.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/connected",
      "@type": "SpecialAbility",
      "name": "Connected",
      "slug": "connected",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.41",
        "heading": "Connected",
        "lineStart": 1276,
        "lineEnd": 1280
      },
      "rulesText": "During downtime, you get **+1 result level** when you **acquire an asset** or **reduce heat**.",
      "commentary": "Your array of underworld connections can be leveraged to loan assets, pressure a vendor to give you a better deal, intimidate witnesses, etc.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/daredevil",
      "@type": "SpecialAbility",
      "name": "Daredevil",
      "slug": "daredevil",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.28",
        "heading": "Daredevil",
        "lineStart": 1194,
        "lineEnd": 1198
      },
      "rulesText": "When you roll a **desperate** action, you get **+1d** to your roll if you also take **-1d** to any resistance rolls against consequences from your action.",
      "commentary": "This special ability is a bit of a gamble. The bonus die helps you, but if you suffer consequences, they'll probably be more costly to resist. But hey, you're a daredevil, so no big deal, right?",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/deadly",
      "@type": "SpecialAbility",
      "name": "Deadly",
      "slug": "deadly",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.8",
        "heading": "Deadly",
        "lineStart": 1623,
        "lineEnd": 1627
      },
      "rulesText": "Each PC may add +1 action rating to **Hunt**, **Prowl**, or **Skirmish** (up to a max rating of 3).",
      "commentary": "Each player may choose the action they prefer (you don't all have to choose the same one). If you take this ability during initial character and crew creation, it supersedes the normal starting limit for action ratings.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/death-veil",
      "@type": "SpecialAbility",
      "name": "Death veil",
      "slug": "death-veil",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.9",
        "heading": "Death veil",
        "lineStart": 1629,
        "lineEnd": 1631
      },
      "rulesText": "Due to hard-won experience or occult ritual, you don't take extra **heat** when killing is involved on a score.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/expertise",
      "@type": "SpecialAbility",
      "name": "Expertise",
      "slug": "expertise",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.30",
        "heading": "Expertise",
        "lineStart": 1210,
        "lineEnd": 1214
      },
      "rulesText": "Choose one of your action ratings. When you lead a group action using that action, you can suffer only 1 stress at most, regardless of the number of failed rolls.",
      "commentary": "This special ability is good for covering for your team. If they're all terrible at your favored action, you don't have to worry about suffering a lot of stress when you lead their group action.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/fiends",
      "@type": "SpecialAbility",
      "name": "Fiends",
      "slug": "fiends",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.13",
        "heading": "Fiends",
        "lineStart": 1651,
        "lineEnd": 1655
      },
      "rulesText": "Fear is as good as respect. You may count each **wanted level** as if it were **turf**.",
      "commentary": "The maximum **wanted level** is 4. Regardless of how much turf you hold (from this ability or otherwise) the minimum **rep** cost to advance your Tier is always 6.*",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/focused",
      "@type": "SpecialAbility",
      "name": "Focused",
      "slug": "focused",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.16",
        "heading": "Focused",
        "lineStart": 1124,
        "lineEnd": 1128
      },
      "rulesText": "You may expend your **special armor** to resist a consequence of surprise or mental harm (fear, confusion, losing track of someone) or to **push yourself** for ranged combat or tracking.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you \"resist a consequence\" of the appropriate type, you avoid it completely. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/foresight",
      "@type": "SpecialAbility",
      "name": "Foresight",
      "slug": "foresight",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.39",
        "heading": "Foresight",
        "lineStart": 1264,
        "lineEnd": 1268
      },
      "rulesText": "Two times per score you can **assist** a teammate without paying stress. Describe how you prepared for this.",
      "commentary": "You can narrate an event in the past that helps your teammate now, or you might explain how you expected this situation and planned a helpful contingency that you reveal now.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/forged-in-the-fire",
      "@type": "SpecialAbility",
      "name": "Forged in the fire",
      "slug": "forged-in-the-fire",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.14",
        "heading": "Forged in the fire",
        "lineStart": 1657,
        "lineEnd": 1661
      },
      "rulesText": "Each PC has been toughened by cruel experience. You get **+1d** to **resistance** rolls.",
      "commentary": "This ability applies to PCs in the crew. It doesn't confer any special toughness to your cohorts.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/fortitude",
      "@type": "SpecialAbility",
      "name": "Fortitude",
      "slug": "fortitude",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.23",
        "heading": "Fortitude",
        "lineStart": 1162,
        "lineEnd": 1166
      },
      "rulesText": "You may expend your **special armor** to resist a consequence of fatigue, weakness, or chemical effects, or to **push yourself** when working with technical skill or handling alchemicals.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you \"resist a consequence\" of the appropriate type, you avoid it completely. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/high-society",
      "@type": "SpecialAbility",
      "name": "High society",
      "slug": "high-society",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.18",
        "heading": "High society",
        "lineStart": 1677,
        "lineEnd": 1679
      },
      "rulesText": "It's all about who you know. Take **-1 **heat**** during downtime and **+1d** to **gather information** about the city's elite.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/infiltrator",
      "@type": "SpecialAbility",
      "name": "Infiltrator",
      "slug": "infiltrator",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.26",
        "heading": "Infiltrator",
        "lineStart": 1180,
        "lineEnd": 1186
      },
      "rulesText": "You are not affected by **quality** or **Tier** when you bypass security measures.",
      "commentary": "This ability lets you contend with higher-Tier enemies on equal footing. When you're cracking a safe, picking a lock, or sneaking past elite guards, your effect level is never reduced due to superior Tier or quality level of your opposition.\n\nAre you a renowned safe cracker? Do people tell stories of how you slipped under the noses of two Chief Inspectors, or are your exceptional talents yet to be discovered?",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/iron-will",
      "@type": "SpecialAbility",
      "name": "Iron will",
      "slug": "iron-will",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.45",
        "heading": "Iron will",
        "lineStart": 1298,
        "lineEnd": 1302
      },
      "rulesText": "You are immune to the terror that some supernatural entities inflict on sight. When you make a **resistance roll** with **Resolve**, take **+1d**.",
      "commentary": "With this ability, you do not freeze up or flee when confronted by any kind of supernatural entity or strange occult event.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/just-passing-through",
      "@type": "SpecialAbility",
      "name": "Just passing through",
      "slug": "just-passing-through",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.23",
        "heading": "Just passing through",
        "lineStart": 1701,
        "lineEnd": 1703
      },
      "rulesText": "During **downtime**, take **-1 **heat****. When your **heat** is 4 or less, you get **+1d** to deceive people when you pass yourselves off as ordinary citizens.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/leader",
      "@type": "SpecialAbility",
      "name": "Leader",
      "slug": "leader",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.10",
        "heading": "Leader",
        "lineStart": 1082,
        "lineEnd": 1086
      },
      "rulesText": "When you **Command** a **cohort** in combat, they continue to fight when they would otherwise **break** (they're not taken out when they suffer level 3 harm). They gain **+1 effect** and **1 armor**.",
      "commentary": "This ability makes your cohorts more effective in battle and also allows them to resist harm by using armor. While you lead your cohorts, they won't stop fighting until they take fatal harm (level 4) or you order them to cease. What do you do to inspire such bravery in battle?",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/like-looking-into-a-mirror",
      "@type": "SpecialAbility",
      "name": "Like looking into a mirror",
      "slug": "like-looking-into-a-mirror",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.34",
        "heading": "Like looking into a mirror",
        "lineStart": 1234,
        "lineEnd": 1238
      },
      "rulesText": "You can always tell when someone is lying to you.",
      "commentary": "This ability works in all situations without restriction. It is very powerful, but also a bit of a curse. You see though every lie, even the kind ones.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/mastermind",
      "@type": "SpecialAbility",
      "name": "Mastermind",
      "slug": "mastermind",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.42",
        "heading": "Mastermind",
        "lineStart": 1282,
        "lineEnd": 1286
      },
      "rulesText": "You may expend your **special armor** to **protect** a teammate, or to **push yourself** when you gather information or work on a long-term project.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you protect a teammate, this ability negates or reduces the severity of a consequence or harm that your teammate is facing. You don't have to be present to use this ability—say how you prepared for this situation in the past. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/mesmerism",
      "@type": "SpecialAbility",
      "name": "Mesmerism",
      "slug": "mesmerism",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.36",
        "heading": "Mesmerism",
        "lineStart": 1246,
        "lineEnd": 1250
      },
      "rulesText": "When you **Sway** someone, you may cause them to forget that it's happened until they next interact with you.",
      "commentary": "The victim's memory \"glosses over\" the missing time, so it's not suspicious that they've forgotten something. When you next interact with the victim, they remember everything clearly, including the strange effect of this ability.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/mule",
      "@type": "SpecialAbility",
      "name": "Mule",
      "slug": "mule",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.11",
        "heading": "Mule",
        "lineStart": 1088,
        "lineEnd": 1092
      },
      "rulesText": "Your load limits are higher. Light: 5. Normal: 7. Heavy: 8.",
      "commentary": "This ability is great if you want to wear heavy armor and pack a heavy weapon without attracting lots of attention. Since your exact gear is determined on-the-fly during an operation, having more load also gives you more options to get creative with when dealing with problems during a score.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/no-traces",
      "@type": "SpecialAbility",
      "name": "No traces",
      "slug": "no-traces",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.10",
        "heading": "No traces",
        "lineStart": 1633,
        "lineEnd": 1637
      },
      "rulesText": "When you keep an operation quiet or make it look like an accident, you get half the **rep** value of the target (round up) instead of zero. When you end downtime with zero **heat**, take **+1** **rep**.",
      "commentary": "There are many clients who value quiet operations. This ability rewards you for keeping a low-profile.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/not-to-be-trifled-with",
      "@type": "SpecialAbility",
      "name": "Not to be trifled with",
      "slug": "not-to-be-trifled-with",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.12",
        "heading": "Not to be trifled with",
        "lineStart": 1094,
        "lineEnd": 1100
      },
      "rulesText": "You can **push yourself** to do one of the following: *perform a feat of physical force that verges on the superhuman—engage a small gang on equal footing in close combat.*",
      "commentary": "When you push yourself to activate this ability, you still get one of the normal benefits of pushing yourself (+1d, +1 effect, etc.) in addition to the special ability.\n\nIf you perform a feat that verges on the superhuman, you might break a metal weapon with your bare hands, tackle a galloping horse, lift a huge weight, etc. If you engage a small gang on equal footing, you don't suffer reduced effect due to scale against a small gang (up to six people).",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/pack-rats",
      "@type": "SpecialAbility",
      "name": "Pack rats",
      "slug": "pack-rats",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.19",
        "heading": "Pack rats",
        "lineStart": 1681,
        "lineEnd": 1685
      },
      "rulesText": "Your lair is a jumble of stolen items. When you roll to **acquire an asset**, take **+1d**.",
      "commentary": "This ability might mean that you actually have the item you need in your pile of stuff, or it could mean you have extra odds and ends to barter with.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/patron",
      "@type": "SpecialAbility",
      "name": "Patron",
      "slug": "patron",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.11",
        "heading": "Patron",
        "lineStart": 1639,
        "lineEnd": 1643
      },
      "rulesText": "When you advance your **Tier**, it costs half the **coin** it normally would.",
      "commentary": "Who is your patron? Why do they help you?",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/predators",
      "@type": "SpecialAbility",
      "name": "Predators",
      "slug": "predators",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.12",
        "heading": "Predators",
        "lineStart": 1645,
        "lineEnd": 1649
      },
      "rulesText": "When you use a stealth or deception plan to commit murder, take **+1d** to the **engagement roll**.",
      "commentary": "This ability applies when the goal is murder. It doesn't apply to other stealth or deception operations you attempt that happen to involve killing.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/reflexes",
      "@type": "SpecialAbility",
      "name": "Reflexes",
      "slug": "reflexes",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.31",
        "heading": "Reflexes",
        "lineStart": 1216,
        "lineEnd": 1220
      },
      "rulesText": "When there's a question about who acts first, the answer is you.",
      "commentary": "This ability gives you the initiative in most situations. Some specially trained NPCs might also have reflexes, but otherwise, you're always the first to act, and can interrupt anyone else who tries to beat you to the punch. This ability usually doesn't negate the need to make an action roll that you would otherwise have to make, but it may improve your position or effect.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/ritual",
      "@type": "SpecialAbility",
      "name": "Ritual",
      "slug": "ritual",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.46",
        "heading": "Ritual",
        "lineStart": 1304,
        "lineEnd": 1308
      },
      "rulesText": "You know the arcane methods to perform ritual sorcery. You can **Study** an occult ritual (or create a new one) to summon a supernatural effect or being. You begin with one ritual already learned.",
      "commentary": "Without this special ability, the study and practice of rituals leaves you utterly vulnerable to the powers you supplicate. Such endeavors are not recommended.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/rooks-gambit",
      "@type": "SpecialAbility",
      "name": "Rook's gambit",
      "slug": "rooks-gambit",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.33",
        "heading": "Rook's gambit",
        "lineStart": 1228,
        "lineEnd": 1232
      },
      "rulesText": "Take **2 stress** to roll your best action rating while performing a different action. Say how you adapt your skill to this use.",
      "commentary": "This is the \"jack-of-all-trades\" ability. If you want to attempt lots of different sorts of actions and still have a good dice pool to roll, this is the special ability for you.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/saboteur",
      "@type": "SpecialAbility",
      "name": "Saboteur",
      "slug": "saboteur",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.25",
        "heading": "Saboteur",
        "lineStart": 1174,
        "lineEnd": 1178
      },
      "rulesText": "When you **Wreck**, your work is much quieter than it should be and the damage is very well-hidden from casual inspection.",
      "commentary": "You can drill holes in things, melt stuff with acid, even use a muffled explosive, and it will all be very quiet and extremely hard to notice.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/savage",
      "@type": "SpecialAbility",
      "name": "Savage",
      "slug": "savage",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.13",
        "heading": "Savage",
        "lineStart": 1102,
        "lineEnd": 1108
      },
      "rulesText": "When you unleash physical violence, it's especially frightening. When you **Command** a frightened target, take **+1d**.",
      "commentary": "You instill fear in those around you when you get violent. How they react depends on the person. Some people will flee from you, some will be impressed, some will get violent in return. The GM judges the response of a given NPC.\n\nIn addition, when you **Command** someone who's affected by fear (from this ability or otherwise), take +1d to your roll.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/scout",
      "@type": "SpecialAbility",
      "name": "Scout",
      "slug": "scout",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.17",
        "heading": "Scout",
        "lineStart": 1130,
        "lineEnd": 1134
      },
      "rulesText": "When you gather information to discover the location of a target, you get **+1 effect**. When you hide in a prepared position or use camouflage you get **+1d** to rolls to avoid detection.",
      "commentary": "A \"target\" can be a person, a destination, a good ambush spot, an item, etc.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/second-story",
      "@type": "SpecialAbility",
      "name": "Second story",
      "slug": "second-story",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.20",
        "heading": "Second story",
        "lineStart": 1687,
        "lineEnd": 1689
      },
      "rulesText": "When you execute a clandestine infiltration, you get **+1d** to the **engagement roll**.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/shadow",
      "@type": "SpecialAbility",
      "name": "Shadow",
      "slug": "shadow",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.32",
        "heading": "Shadow",
        "lineStart": 1222,
        "lineEnd": 1226
      },
      "rulesText": "You may expend your **special armor** to resist a consequence from detection or security measures, or to **push yourself** for a feat of athletics or stealth.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you \"resist a consequence\" of the appropriate type, you avoid it completely. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/sharpshooter",
      "@type": "SpecialAbility",
      "name": "Sharpshooter",
      "slug": "sharpshooter",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.15",
        "heading": "Sharpshooter",
        "lineStart": 1116,
        "lineEnd": 1122
      },
      "rulesText": "You can **push yourself** to do one of the following: *make a ranged attack at extreme distance beyond what's normal for the weapon—unleash a barrage of rapid fire to suppress the enemy.*",
      "commentary": "When you push yourself to activate this ability, you still get one of the normal benefits of pushing yourself (+1d, +1 effect, etc.) in addition to the special ability.\n\nThe first use of this ability allows you to attempt long-range sniper shots that would otherwise be impossible with  typical rudimentary firearms. The second use allows you to keep up a steady rate of fire in a battle (enough to \"suppress\" a small gang up to six people), rather than stopping for a slow reload or discarding a gun after each shot. When an enemy is suppressed, they're reluctant to maneuver or attack (usually calling for a fortune roll to see if they can manage it).",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/strange-methods",
      "@type": "SpecialAbility",
      "name": "Strange methods",
      "slug": "strange-methods",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.47",
        "heading": "Strange methods",
        "lineStart": 1310,
        "lineEnd": 1314
      },
      "rulesText": "When you **invent** or **craft** a creation with *arcane* features, get **+1 result level** to your roll (a **1-3** becomes a **4/5**, etc.). You begin with one arcane design already known.",
      "commentary": "Follow the Inventing procedure with the GM  to define your first arcane design.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/subterfuge",
      "@type": "SpecialAbility",
      "name": "Subterfuge",
      "slug": "subterfuge",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.37",
        "heading": "Subterfuge",
        "lineStart": 1252,
        "lineEnd": 1256
      },
      "rulesText": "You may expend your **special armor** to resist a consequence from suspicion or persuasion, or to **push yourself** for subterfuge.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you \"resist a consequence\" of the appropriate type, you avoid it completely. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/supernatural-ward",
      "@type": "SpecialAbility",
      "name": "Supernatural ward",
      "slug": "supernatural-ward",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.24",
        "heading": "Supernatural ward",
        "lineStart": 1168,
        "lineEnd": 1172
      },
      "rulesText": "When you **Wreck** an area with arcane substances, ruining it for any other use, it becomes anathema or enticing to the supernatural (your choice).",
      "commentary": "If you make an area anathema to the supernatural, they will do everything they can to avoid it, and will suffer torment if forced inside the area. If you make an area enticing to spirits, they will seek it out and linger in the area, and will suffer torment if forced to leave. This effect lasts for several days over an area the size of a small room. Particularly powerful or prepared entities may roll their quality or arcane magnitude to see how well they're able to resist the effect.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/synchronized",
      "@type": "SpecialAbility",
      "name": "Synchronized",
      "slug": "synchronized",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.21",
        "heading": "Synchronized",
        "lineStart": 1691,
        "lineEnd": 1695
      },
      "rulesText": "When you perform a **group action**, you may count multiple 6s from different rolls as a **critical** success.",
      "commentary": "For example, Lyric leads a group action to **Attune** to the ghost field to overcome a magical ward on the Dimmer Sisters' door. Emily, Lyric's player, rolls and gets a **6**, and so does Matt! Because the crew has Synchronized, their two separate **6**s count as a **critical** success on the roll.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/the-devils-footsteps",
      "@type": "SpecialAbility",
      "name": "The devil's footsteps",
      "slug": "the-devils-footsteps",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.29",
        "heading": "The devil's footsteps",
        "lineStart": 1200,
        "lineEnd": 1208
      },
      "rulesText": "You can **push yourself** to do one of the following: *perform a feat of athletics that verges on the superhuman—maneuver to confuse your enemies so they mistakenly attack each other.*",
      "commentary": "When you push yourself to activate this ability, you still get one of the normal benefits of pushing yourself (+1d, +1 effect, etc.) if you're making a roll, in addition to the special ability.\n\nIf you perform an athletic feat (running, tumbling, balance, climbing, etc.) that verges on the superhuman, you might climb a sheer surface that lacks good hand-holds, tumble safely out of a three-story fall, leap a shocking distance, etc.\n\nIf you maneuver to confuse your enemies, they attack each other for a moment before they realize their mistake. The GM might make a fortune roll to see how badly they harm or interfere with each other.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/tough-as-nails",
      "@type": "SpecialAbility",
      "name": "Tough as nails",
      "slug": "tough-as-nails",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.18",
        "heading": "Tough as nails",
        "lineStart": 1136,
        "lineEnd": 1140
      },
      "rulesText": "Penalties from harm are one level less severe (though level 4 harm is still fatal).",
      "commentary": "With this ability, level 3 harm doesn't incapacitate you; instead you take -1d to your rolls (as if it were level 2 harm). Level 2 harm affects you as if it were level 1 (less effect). Level 1 harm has no effect on you (but you still write it on your sheet, and must recover to heal it). Record the harm at its original level—for healing purposes, the original harm level applies.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/trust-in-me",
      "@type": "SpecialAbility",
      "name": "Trust in me",
      "slug": "trust-in-me",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.38",
        "heading": "Trust in me",
        "lineStart": 1258,
        "lineEnd": 1262
      },
      "rulesText": "You get **+1d** vs. a target with whom you have an intimate relationship.",
      "commentary": "This ability isn't just for social interactions. Any action can get the bonus. \"Intimate\" is for you and the group to define, it need not exclusively mean romantic intimacy.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/vengeful",
      "@type": "SpecialAbility",
      "name": "Vengeful",
      "slug": "vengeful",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.19",
        "heading": "Vengeful",
        "lineStart": 1142,
        "lineEnd": 1144
      },
      "rulesText": "You gain an additional **xp trigger**: *You got payback against someone who harmed you or someone you care about.* If your crew helped you get payback, also mark crew xp.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/vigorous",
      "@type": "SpecialAbility",
      "name": "Vigorous",
      "slug": "vigorous",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.14",
        "heading": "Vigorous",
        "lineStart": 1110,
        "lineEnd": 1114
      },
      "rulesText": "You recover from harm faster. Permanently fill in one of your healing clock segments. Take **+1d** to healing treatment rolls.",
      "commentary": "Your healing clock becomes a 3-clock, and you get a bonus die when you recover.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/war-dogs",
      "@type": "SpecialAbility",
      "name": "War dogs",
      "slug": "war-dogs",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Crew playbook",
        "section": "20.15",
        "heading": "War dogs",
        "lineStart": 1663,
        "lineEnd": 1665
      },
      "rulesText": "When you're at war (-3 faction status), your crew does not suffer -1 hold and PCs still get two downtime activities, instead of just one.",
      "abilityScope": "crew"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/warded",
      "@type": "SpecialAbility",
      "name": "Warded",
      "slug": "warded",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.48",
        "heading": "Warded",
        "lineStart": 1316,
        "lineEnd": 1320
      },
      "rulesText": "You may expend your **special armor** to resist a supernatural consequence, or to **push yourself** when you contend with or employ arcane forces.",
      "commentary": "When you use this ability, tick the special armor box on your playbook sheet. If you resist a consequence, this ability negates or reduces its severity. If you use this ability to push yourself, you get one of the benefits (+1d, +1 effect, act despite severe harm) but you don't take 2 stress. Your special armor is restored at the beginning of downtime.",
      "abilityScope": "character"
    },
    {
      "@id": "https://cheeleong.dev/fitd-system-json/objects/special-abilities/weaving-the-web",
      "@type": "SpecialAbility",
      "name": "Weaving the web",
      "slug": "weaving-the-web",
      "source": {
        "@id": "https://cheeleong.dev/fitd-system-json/objects/sources/blades-in-the-dark-srd"
      },
      "sourceLocator": {
        "chapter": "Character playbook",
        "section": "18.43",
        "heading": "Weaving the web",
        "lineStart": 1288,
        "lineEnd": 1292
      },
      "rulesText": "You gain **+1d** to **Consort** when you gather information on a target for a score. You get **+1d** to the **engagement roll** for that operation.",
      "commentary": "Your network of underworld connections can always be leveraged to gain insight for a job—even when your contacts aren't aware that they're helping you.",
      "abilityScope": "character"
    },
