cff-version: 1.2.0
message: "If you use this dataset, please cite it as below."
title: "Blades in the Dark SRD System JSON"
type: dataset
authors:
  - family-names: "Chow"
    given-names: "Chee Leong"
version: "0.1.0"
date-released: "2026-08-24"
license:
  - CC-BY-3.0
  - MIT
url: "https://cheeleong.dev/fitd-system-json/"
repository-code: "https://github.com/klrkdekira/fitd-system-json"
abstract: >-
  A source-faithful JSON-LD 1.1 reference corpus and JSON Schema Draft
  2020-12 specifications for the Blades in the Dark SRD by John Harper
  (One Seven Design, CC-BY-3.0). Includes rules, tables, actions, special
  abilities, entanglements, downtime activities, claims, and trauma
  conditions with line-level source provenance.
references:
  - type: manual
    title: "Blades in the Dark SRD"
    authors:
      - family-names: "Harper"
        given-names: "John"
    url: "https://bladesinthedark.com/"
    license: "CC-BY-3.0"
  - type: data
    title: "Blades in the Dark System Reference Document (Markdown conversion)"
    authors:
      - name: "Randy Oest (amazingrando)"
    url: "https://github.com/amazingrando/blades-in-the-dark-srd-content"
