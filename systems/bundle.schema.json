{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/fitd-system-json/systems/bundle.schema.json",
  "title": "Blades in the Dark SRD JSON-LD bundle",
  "type": "object",
  "properties": {
    "@context": { "const": "https://cheeleong.dev/fitd-system-json/systems/context.jsonld" },
    "@id": { "type": "string", "format": "iri" },
    "@type": { "const": "SRDSystemData" },
    "version": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "@graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "@id": { "type": "string", "format": "iri" },
          "@type": { "type": "string", "minLength": 1 }
        },
        "required": ["@id", "@type"]
      }
    }
  },
  "required": ["@context", "@id", "@type", "version", "metadata", "@graph"],
  "unevaluatedProperties": false
}
