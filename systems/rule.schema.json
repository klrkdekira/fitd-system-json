{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/fitd-system-json/systems/rule.schema.json",
  "title": "Blades in the Dark SRD Rule",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Rule" },
    "section": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "rulesText": { "type": "string", "minLength": 1 },
    "relatedRules": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    },
    "relatedTables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/NodeReference" }
    }
  },
  "required": ["section"],
  "unevaluatedProperties": false
}
