{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/fitd-system-json/systems/table.schema.json",
  "title": "Blades in the Dark SRD Table",
  "$ref": "common.schema.json#/$defs/EntityBase",
  "properties": {
    "@type": { "const": "Table" },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/TableRow" }
    },
    "rawText": { "type": "string", "minLength": 1 }
  },
  "required": ["columns", "rows", "rawText"],
  "unevaluatedProperties": false
}
