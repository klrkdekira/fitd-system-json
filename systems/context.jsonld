{
  "@context": {
    "@version": 1.1,
    "@base": "https://cheeleong.dev/fitd-system-json/",
    "@vocab": "https://cheeleong.dev/fitd-system-json/vocab/#",
    "fitd": "https://cheeleong.dev/fitd-system-json/vocab/#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "name": "schema:name",
    "description": "schema:description",
    "publisher": "schema:publisher",
    "slug": "fitd:slug",
    "rulesText": "fitd:rulesText",
    "examplesText": "fitd:examplesText",
    "commentary": "fitd:commentary",
    "attribute": "fitd:attribute",
    "abilityScope": "fitd:abilityScope",
    "claimType": "fitd:claimType",
    "detail": "fitd:detail",
    "partOf": { "@id": "fitd:partOf", "@type": "@id" },
    "source": { "@id": "dcterms:source", "@type": "@id" },
    "sourceLocator": "fitd:sourceLocator",
    "license": "fitd:licenseCode",
    "licenseUrl": { "@id": "fitd:licenseUrl", "@type": "@id" },
    "attributionStatement": "fitd:attributionStatement",
    "conversionStatement": "fitd:conversionStatement",
    "canonicalUrl": { "@id": "fitd:canonicalUrl", "@type": "@id" },
    "retrievedFrom": { "@id": "fitd:retrievedFrom", "@type": "@id" },
    "seeAlso": { "@id": "fitd:seeAlso", "@type": "@id", "@container": "@set" },
    "relatedRules": { "@id": "fitd:relatedRule", "@type": "@id", "@container": "@set" },
    "relatedTables": { "@id": "fitd:relatedTable", "@type": "@id", "@container": "@set" },
    "collections": { "@id": "fitd:collection", "@container": "@set" },
    "members": { "@id": "fitd:member", "@type": "@id", "@container": "@set" },
    "schemaReference": { "@id": "fitd:schemaReference", "@type": "@id" },
    "entityType": "fitd:entityType",
    "metadata": "fitd:metadata",
    "contentDigest": "fitd:contentDigest",
    "sourceFile": "fitd:sourceFile",
    "sourceVersion": "fitd:sourceVersion"
  }
}
